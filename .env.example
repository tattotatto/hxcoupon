# Server
SERVER_MODE=release

# 宿主机 MySQL（数据库需提前创建好）
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=hxcoupon

# Redis（容器内运行）
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-random-string-at-least-32-chars

# Alibaba Cloud OSS
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_BUCKET=ynhx
OSS_DOMAIN=https://ynhx.oss-cn-chengdu.aliyuncs.com
